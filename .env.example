# =============================================================
# Harvest Games v2 — Modèle de configuration
# -------------------------------------------------------------
# 1. Copier ce fichier en `.env` à la racine du repo
# 2. Remplir avec les vraies valeurs
# 3. Le fichier `.env` ne doit JAMAIS être versionné
# =============================================================

# --- Neon v2 (PostgreSQL + PostGIS) ---
# Les deux variables pointent vers la même URL (compatibilité scripts v1/v2)
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
NEON_DB_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- AWS S3 (data lake v2) ---
AWS_S3_BUCKET=harvestgames-v2
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=eu-west-3

# --- Copernicus CDS (extraction climat) ---
CDSAPI_URL=https://cds.climate.copernicus.eu/api/
CDSAPI_KEY=your_cds_api_key

# --- API FastAPI locale ---
API_URL=http://127.0.0.1:8001